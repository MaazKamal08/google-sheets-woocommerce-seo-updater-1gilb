    {
      "parameters": {
        "jsCode": "// Get all items from current node and the 'Prepare Data' node\nconst currentItems = $input.all();\nconst preparedDataItems = $('Prepare Data').all();\n\n// Process each item\nreturn currentItems.map((item, index) => {\n  const result = item.json;\n  const original = preparedDataItems[index]?.json || {};\n  \n  let productId = null;\n  let productName = null;\n  \n  // Handle different response structures\n  if (Array.isArray(result) && result.length > 0) {\n    // If result is an array, get first product\n    const product = result[0];\n    productId = product.id;\n    productName = product.name;\n  } else if (result && result.id) {\n    // If result is an object with id\n    productId = result.id;\n    productName = result.name;\n  } else if (result && result.data) {\n    // Handle nested data structure\n    if (Array.isArray(result.data) && result.data.length > 0) {\n      productId = result.data[0].id;\n      productName = result.data[0].name;\n    } else if (result.data.id) {\n      productId = result.data.id;\n      productName = result.data.name;\n    }\n  }\n  \n  // Return result based on whether product was found\n  if (!productId) {\n    return {\n      json: {\n        ...original,\n        status: 'Failed',\n        message: 'Product not found'\n      }\n    };\n  }\n  \n  return {\n    json: {\n      ...original,\n      productId: productId,\n      productName: productName,\n      status: 'Found'\n    }\n  };\n});"
      },
