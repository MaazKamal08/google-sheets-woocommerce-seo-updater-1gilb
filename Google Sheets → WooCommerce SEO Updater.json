{
  "name": "Google Sheets → WooCommerce SEO Updater",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Get all input items\nconst items = $input.all();\n\n// Process each item and return transformed data\nreturn items.map(item => {\n  const row = item.json;\n  \n  // Validate URL exists\n  if (!row.Urls) {\n    throw new Error('No URL found in row');\n  }\n  \n  const url = row.Urls.trim();\n  let slug = '';\n  let isSearchURL = false;\n  \n  // Extract slug from URL\n  if (url.includes('?s=')) {\n    // Handle search URLs\n    isSearchURL = true;\n    const match = url.match(/[?&]s=([^&]+)/);\n    slug = match ? match[1] : '';\n  } else {\n    // Handle regular URLs - extract slug from path\n    const parts = url.split('/').filter(part => part.length > 0);\n    slug = parts[parts.length - 1];\n  }\n  \n  // Return transformed item\n  return {\n    json: {\n      url: url,\n      slug: slug,\n      metaTitle: (row['Meta Title'] || '').trim(),\n      metaDescription: (row['Meta Description'] || row['Meta Description '] || '').trim(),\n      isSearchURL: isSearchURL,\n      status: row.Status || ''\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
